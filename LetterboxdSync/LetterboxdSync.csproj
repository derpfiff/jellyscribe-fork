<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Jellyscribe</AssemblyName>
    <RootNamespace>LetterboxdSync</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyVersion>2.15.0.128</AssemblyVersion>
    <FileVersion>2.15.0.128</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LetterboxdSync.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <!-- Jellyfin 12.4 fork: built against the server's own assemblies (copied to ../lib from a
         Jellyfin 12.4 install) instead of the 10.11 NuGet packages. DataProtection comes with the
         ASP.NET Core shared framework that Jellyfin already loads. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="MediaBrowser.Common"><HintPath>../lib/MediaBrowser.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MediaBrowser.Controller"><HintPath>../lib/MediaBrowser.Controller.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MediaBrowser.Model"><HintPath>../lib/MediaBrowser.Model.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Jellyfin.Data"><HintPath>../lib/Jellyfin.Data.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Jellyfin.Database.Implementations"><HintPath>../lib/Jellyfin.Database.Implementations.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Jellyfin.Extensions"><HintPath>../lib/Jellyfin.Extensions.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>../lib/Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Fork: the File Transformation sidebar task is not built (no Jellyscribe entry in the web client). -->
  <ItemGroup>
    <Compile Remove="SidebarInjection.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\sidebar.js" />
    <EmbeddedResource Include="Web\jellyscribe.css" />
    <!-- Both dashboards load jellyscribe.js/.css with ?v=<this build's version>, and jellyscribe.js
         registers itself under the same version, so these three are embedded from copies with the
         version stamped in (StampWebAssetVersion below). -->
    <VersionedWebAsset Include="Web\configPage.html;Web\userPage.html;Web\jellyscribe.js" />
    <EmbeddedResource Include="@(VersionedWebAsset->'$(IntermediateOutputPath)web\%(Filename)%(Extension)')" LogicalName="LetterboxdSync.Web.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Copies a file with @@JELLYSCRIBE_VERSION@@ replaced, byte for byte otherwise, and leaves the copy
       untouched when it would not change. -->
  <UsingTask TaskName="StampVersion" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
      <Version ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var text = System.IO.File.ReadAllText(Source).Replace("@@JELLYSCRIBE_VERSION@@", Version);
        System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(Destination));
        if (!System.IO.File.Exists(Destination) || System.IO.File.ReadAllText(Destination) != text)
            System.IO.File.WriteAllText(Destination, text, new System.Text.UTF8Encoding(false));
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- A Debug build (deploy.sh) keeps the release's version, so its stamp gets "-dev": the server then
       never lets a browser cache it for good, and a redeployed debug build is picked up. -->
  <PropertyGroup>
    <WebAssetVersion>$(AssemblyVersion)</WebAssetVersion>
    <WebAssetVersion Condition="'$(Configuration)' == 'Debug'">$(AssemblyVersion)-dev</WebAssetVersion>
  </PropertyGroup>

  <Target Name="StampWebAssetVersion" BeforeTargets="BeforeBuild">
    <StampVersion Source="%(VersionedWebAsset.FullPath)" Destination="$(IntermediateOutputPath)web\%(VersionedWebAsset.Filename)%(VersionedWebAsset.Extension)" Version="$(WebAssetVersion)" />
  </Target>

</Project>
